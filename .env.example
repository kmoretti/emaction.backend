NODE_ENV=production
HOST=0.0.0.0
PORT=8080
APP_VERSION=dev

# mysql (production default)
DB_DRIVER=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=emaction
MYSQL_USER=emaction_app
MYSQL_PASSWORD=change-me
MYSQL_CONNECTION_LIMIT=5
MYSQL_CONNECT_TIMEOUT_MS=5000

# sqlite / explicit startup fallback
# DB_DRIVER=sqlite
# SQLITE_PATH=/data/emaction.sqlite
# SQLITE_BUSY_TIMEOUT_MS=5000
